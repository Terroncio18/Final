{
  "name": "ignislabs-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node ../scripts/lcov-paths.mjs api coverage/lcov.info",
    "fuels:prepare": "npm run build && node scripts/prepare-fuels.mjs",
    "fuels:official": "npm run build && node scripts/prepare-official-fuels.mjs",
    "fuels:verify": "vitest run --config vitest.live.config.ts",
    "start": "node --env-file=.env dist/server.js",
    "dev": "tsc --watch --preserveWatchOutput & node --env-file=.env --watch dist/server.js"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "geotiff": "^3.0.5"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "proj4": "^2.23.0",
    "shapefile": "^0.6.6",
    "@types/node": "^22.10.2",
    "@types/shapefile": "^0.6.4",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "~6.0.2",
    "vitest": "^5.1.1"
  }
}
