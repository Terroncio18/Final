{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "web": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "maplibre-gl-worker.mjs",
                "input": "node_modules/maplibre-gl/dist",
                "output": "/"
              }
            ],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.6MB",
                  "maximumError": "1.75MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "20kB",
                  "maximumError": "28kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "web:build:production"
            },
            "development": {
              "buildTarget": "web:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.config.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "exclude": ["app/simulation/**"]
          },
          "configurations": {
            "coverage": {
              "coverage": true,
              "coverageInclude": ["src/app/**/*.ts"],
              "coverageExclude": [
                "**/*.spec.ts",
                "src/app/simulation/{agents,bounds,countermeasures,domain,fire-display,fire-distances,fire-emitters,fire-spread,fire-surface,fuel-data,fuel-treatments,fuel.service,geo,point,point-locator,rothermel,scenario,slope-classes,spotting,terrain,terrain.service,wind}.ts",
                "src/app/map/{agents-3d,fire-particles}.ts"
              ],
              "coverageReporters": ["text", "html", "lcovonly", "json"]
            }
          }
        }
      }
    }
  }
}
