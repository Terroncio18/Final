{
  "name": "ignislab-web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:simulation && ng test",
    "test:simulation": "vitest run src/app/simulation",
    "test:coverage": "npm run test:simulation -- --coverage && ng test --configuration coverage && node ../scripts/lcov-paths.mjs web coverage/model/lcov.info coverage/web/lcov.info",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:regions": "node scripts/fetch-regions.mjs",
    "data:provinces": "node scripts/fetch-provinces.mjs",
    "data:municipalities": "node --max-old-space-size=6144 scripts/fetch-municipalities.mjs",
    "data:places": "node scripts/fetch-places.mjs",
    "data:index": "node scripts/build-index.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "maplibre-contour": "^0.1.1",
    "maplibre-gl": "^6.15.0",
    "rxjs": "~7.8.0",
    "three": "0.186.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
